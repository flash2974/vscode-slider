{
  "name": "inline-number-slider",
  "displayName": "Inline number slider",
  "description": "Interactive mini-slider for vscode numbers",
  "version": "1.0.0",
  "publisher": "flash2974",
  "author": {
    "name": "Nathan Domenichini"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flash2974/vscode-slider"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "slider",
    "number",
    "scrubber",
    "typst",
    "css",
    "html",
    "units",
    "tweaker"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "numberSlider.set",
        "title": "Set Number Value",
        "category": "Number Slider"
      },
      {
        "command": "numberSlider.step",
        "title": "Step Number Value",
        "category": "Number Slider"
      },
      {
        "command": "numberSlider.increment",
        "title": "Increment Number (+1)",
        "category": "Number Slider"
      },
      {
        "command": "numberSlider.decrement",
        "title": "Decrement Number (-1)",
        "category": "Number Slider"
      },
      {
        "command": "numberSlider.incrementLarge",
        "title": "Increment Number (+10)",
        "category": "Number Slider"
      },
      {
        "command": "numberSlider.decrementLarge",
        "title": "Decrement Number (-10)",
        "category": "Number Slider"
      }
    ],
    "keybindings": [
      {
        "command": "numberSlider.increment",
        "key": "alt+right",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.decrement",
        "key": "alt+left",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.incrementLarge",
        "key": "alt+shift+right",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.decrementLarge",
        "key": "alt+shift+left",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.increment",
        "key": "alt+up",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.decrement",
        "key": "alt+down",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.incrementLarge",
        "key": "alt+shift+up",
        "when": "editorTextFocus"
      },
      {
        "command": "numberSlider.decrementLarge",
        "key": "alt+shift+down",
        "when": "editorTextFocus"
      }
    ]
  }
}
